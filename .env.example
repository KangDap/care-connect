# Database URL for connection via pooling
DATABASE_URL=""

# Direct URL for migration
DIRECT_URL=""

# Better Auth Secret (Use at least 32 characters)
BETTER_AUTH_SECRET=""

# Better Auth Base URL (for example localhost for dev)
BETTER_AUTH_URL=http://localhost:3000

# SMTP Config
SMTP_HOST=
SMTP_PORT=587 # TLS
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CareConnect <no-reply@careconnect.local>"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public Supabase URL
NEXT_PUBLIC_SUPABASE_URL=

# Service Role Key for Supabase
SUPABASE_SERVICE_ROLE_KEY=

# AI Service URL (FastAPI backend services)
AI_SERVICE_URL=http://localhost:8000

# Midtrans Sandbox
MIDTRANS_CLIENT_KEY=

MIDTRANS_SERVER_KEY=

# Login mode (frontend). true or unset: login + register with email/Google (CareConnect).
# false: only "Sign in with PAuS" (Unpad environment, Universitas Padjadjaran community only).
# Inlined at build time, so it must be set before `npm run build`.
NEXT_PUBLIC_REGISTRATION_ENABLED=true

# MinIO Object Storage (Unpad Platform S3)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# PAuS SSO (OAuth 2.0 Credentials from DPSI Unpad)
PAUS_CLIENT_ID=
PAUS_CLIENT_SECRET=
# Must match the callback registered with PAuS for this environment.
PAUS_REDIRECT_URI=http://localhost:3000/api/auth/paus/callback
PAUS_AUTHORIZATION_URL=
PAUS_TOKEN_URL=
PAUS_USER_INFO_URL=
PAUS_SIGN_OUT_URL=
# Return URL after PAuS logout; must be accepted by the PAuS client registration.
PAUS_POST_LOGOUT_REDIRECT_URI=
